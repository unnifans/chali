# scripts/.env.example — copy to .env and fill in
# R2 (S3-compatible) credentials from: Cloudflare Dashboard > R2 > Manage R2 API Tokens > Create
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=chali-media
# Public base for delivered objects (custom domain connected in R2 bucket settings)
R2_PUBLIC_BASE=https://media.chali.in