# Firebase — used ONLY for admin authentication now (logs in with Email/Password,
# then sends an ID token to the Worker as a Bearer token).
# You still need the project id for the admin panel to work.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=

# Cloudflare Worker API base URL (no trailing slash). Same origin works too:
# leave empty if the Worker is bound to the Pages domain at /api/*.
VITE_API_BASE=

# Legacy: image uploads to Cloudinary are currently deferred (R2 migration
# pending). Keep these if you still want the file size/type client checks.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=